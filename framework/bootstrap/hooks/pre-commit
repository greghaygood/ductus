#!/usr/bin/env bash
# Project pre-commit hook. Edit this file freely — /ductus does not overwrite it
# after the initial install. Add your project's pre-commit checks (lint, tests,
# format, etc.) above or below the ductus hook invocation below.

set -euo pipefail
# The ductus hook sits beside this file. Found from here rather than from the
# repository root, so it is found when the project is a subdirectory of its
# repository too.
hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$(git rev-parse --show-toplevel)"

# Keeps ductus's generated artifacts (spec deps, etc.) in sync. /ductus updates
# this script on every run; do not edit it.
"$hooks_dir/ductus-pre-commit"
