# Follow `source`d files (via `# shellcheck source=` directives) so a variable
# a script sets for its sourced helpers to consume is seen as used rather than
# mis-flagged SC2034.
external-sources=true
# Resolve `source=` paths relative to each script's own directory, so a
# `source=lib/helper.sh` directive resolves against the sourcing script rather
# than the cwd shellcheck runs from.
source-path=SCRIPTDIR
# Both settings are inert today: the shipped generators that sourced
# `lib/specs-root.sh` were promoted to the `derive-dependencies` and
# `derive-references` runtime primitives (spec 022), and no tracked script
# currently sources another. They are kept so the next one that does is
# analysed correctly rather than silently mis-flagged.
